# ===================================================
# Application Environment Template (.env.example)
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MySQL Database Configuration
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pg_backend_db

# Redis Configuration (For OTP, BullMQ Queue & Session Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Brevo REST API)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
FROM_NAME=HomeNest

# JWT (JSON Web Token) Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS Configuration
CORS_ORIGIN=*
